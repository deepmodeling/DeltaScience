SHELL = /bin/sh
PWD1 = $(CURDIR)
FC = gfortran
PRECOMP = cpp -traditional -DLINUX
COMPILE = $(FC)
COMPILE_FREE = $(FC) -ffree-form -ffree-line-length-none -ffixed-line-length-none
LINK = ld $(FLAGS) -o
LINK_AR = ar -ruv
LINK_C = gcc -shared -Wl,-z-defs
FLAGS_R = -O2 -fexternal-blas -fbacktrace -fallow-argument-mismatch
FLAGS_D = $(FLAGS_R)
LIBS = -L/opt/physics/lib -lopenblas -lscalapack
LMPI = T
MPI_COMPILE = mpif90
MPI_COMPILE_FREE = mpif90 -ffree-form -ffree-line-length-none -ffixed-line-length-none
MPI_COMPILE_C = mpicc
MPI_LINK = mpif90
MPI_RUN = mpiexec
LNAG = F
LNETCDF = T
NETCDF_INC = $(shell nf-config --fflags)
NETCDF_LIB = $(shell nf-config --flibs)
LNTCC = F
LHDF5 = T
HDF5_INC = -I/opt/physics/include
HDF5_LIB = -L/opt/physics/lib -lhdf5 -lhdf5_hl_fortran -lhdf5_hl -lhdf5_fortran
LSILO = F
LPGPLOT = F
LINTEL = F
LBOOZ = F
LNEO = T
LDKES = F
LVMEC = T
LFIELDLINES = F
LBEAMS3D = F
LPENTA = F
